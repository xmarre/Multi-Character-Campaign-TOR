<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Intentional: the release filename differs from the internal assembly identity. -->
    <AssemblyName>MultiCharacterCampaignTOR.WaywatcherFix</AssemblyName>
    <RootNamespace>MultiCharacterCampaignTOR</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TaleWorlds.Core"><HintPath>$(BannerlordBin)\TaleWorlds.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade"><HintPath>$(BannerlordBin)\TaleWorlds.MountAndBlade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RuntimeHarmonyDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="AssembleRecoveredCareerAbilityRepair" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <RecoveredCareerAbilityRepair>$(IntermediateOutputPath)RecoveredCareerAbilityRepair.cs</RecoveredCareerAbilityRepair>
    </PropertyGroup>
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\MultiCharacterCampaignTOR\RuntimeCompatibility\CareerAbilityRepair.cs">
      <Output TaskParameter="Lines" ItemName="RecoveredCareerAbilityRepairHead" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\MultiCharacterCampaignTOR\RuntimeCompatibility\CareerAbilityRepair.tail.csfrag">
      <Output TaskParameter="Lines" ItemName="RecoveredCareerAbilityRepairTail" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(RecoveredCareerAbilityRepair)" Lines="@(RecoveredCareerAbilityRepairHead);@(RecoveredCareerAbilityRepairTail)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Remove="$(MSBuildProjectDirectory)\MultiCharacterCampaignTOR\RuntimeCompatibility\CareerAbilityRepair.cs" />
      <Compile Include="$(RecoveredCareerAbilityRepair)" />
    </ItemGroup>
  </Target>
  <Target Name="CreateReleaseFilename" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)MultiCharacterCampaignTOR.RuntimeCompatibility.v140.dll" />
  </Target>
</Project>
